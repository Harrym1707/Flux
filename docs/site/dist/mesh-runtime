    $('events').textContent=d.savings.eventsConsidered+' requests'+(d.savings.unpricedEvents?(' \xB7 '+d.savings.unpricedEvents+' unpriced (recorded, not billed)'):'');
    $('active').innerHTML=d.theo.active.length?d.theo.active.map(l=>'<span class="chip on">'+l.lever+'<span class="k"> \xB7 '+l.class+'</span></span>').join(''):'<span class="empty">none</span>';
    $('withheld').innerHTML=d.theo.withheld.length?d.theo.withheld.map(w=>'<span class="chip held" title="'+(w.reason||'')+'">'+w.lever+'</span>').join(''):'<span class="empty">nothing held</span>';
    $('ceiling').textContent='Quality ceiling: '+d.theo.qualityCeilingPercent+'% \u2014 anything that could cost more than this stays off until a replay of your traffic proves it safe.';
    const rows=d.lineItems;
    $('levers').innerHTML=rows.length?rows.map(li=>'<tr><td>'+li.leverId+'</td><td class="k">'+li.kind+(li.basis?' \xB7 '+li.basis:'')+'</td><td class="num">'+li.events+'</td><td class="num">$'+usd(li.savedUsd)+'</td></tr>').join(''):'<tr><td colspan="4" class="empty">No billable savings yet \u2014 run Claude Code through MESH and this fills in.</td></tr>';
