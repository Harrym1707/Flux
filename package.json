{
  "name": "flux",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsc -b",
    "dev:api": "node --import tsx apps/api/src/server.ts",
    "start:api": "node apps/api/dist/src/server.js",
    "example": "node --env-file=.env --import tsx examples/openai-drop-in.ts",
    "example:mock": "node --import tsx examples/mock-drop-in.ts",
    "example:reduce": "node --import tsx examples/reduce-drop-in.ts",
    "example:gate": "node --import tsx examples/replay-gate-demo.ts",
    "example:ceiling": "node --import tsx examples/combined-ceiling.ts",
    "agent:ab": "node --import tsx evals/run-agent-ab.ts",
    "gate:freshcap": "node --import tsx evals/run-replay-gate-freshcap.ts",
    "readless:eval": "node --import tsx evals/run-tool-output-compression.ts",
    "litellm:sample": "node --import tsx evals/make-litellm-traffic.ts",
    "litellm:triage": "node --import tsx evals/run-litellm-triage.ts",
    "gateway:sample": "node --import tsx evals/make-gateway-traffic.ts",
    "gateway:triage": "node --import tsx evals/run-gateway-triage.ts",
    "eval:demo": "node --import tsx evals/run-replay.ts",
    "eval:replay": "node --import tsx evals/run-replay.ts",
    "route:demo": "node --import tsx evals/routing-mvp-demo.ts",
    "route:policy": "node --import tsx evals/create-routing-policy.ts",
    "benchmark:run": "node --import tsx evals/run-benchmark.ts",
    "benchmark:contextual": "node --import tsx evals/run-contextual-benchmark.ts",
    "benchmark:routers": "node --import tsx evals/run-router-comparison.ts",
    "savings:model": "node --import tsx evals/run-savings-model.ts",
    "traffic:sample": "node --import tsx evals/make-sample-traffic.ts",
    "traffic:regression": "node --import tsx evals/run-analysis-regression.ts",
    "techniques:compare": "node --import tsx evals/run-technique-comparison.ts",
    "analyse": "node --import tsx packages/cli/src/main.ts",
    "flux": "node --import tsx packages/cli/src/main.ts",
    "eval:output-style": "node --import tsx evals/run-output-style.ts",
    "benchmark:captures": "node --import tsx evals/run-capture-benchmark.ts",
    "tokenizer:calibrate": "node --import tsx evals/run-tokenizer-calibration.ts",
    "typecheck:evals": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck evals/benchmark.ts evals/contextual-router.ts evals/run-benchmark.ts evals/run-contextual-benchmark.ts evals/run-capture-benchmark.ts evals/benchmark.test.ts evals/reference-routers.ts evals/run-router-comparison.ts evals/reference-routers.test.ts evals/agent-fixture.ts evals/run-replay-gate-freshcap.ts evals/run-replay-gate-freshcap.test.ts evals/run-output-style.ts packages/cli/src/main.ts packages/cli/src/compress.ts packages/cli/src/stats.ts packages/cli/src/compress.test.ts packages/cli/src/stats.test.ts evals/run-tool-output-compression.ts evals/run-tool-output-compression.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@flux-ai/sdk": "workspace:*",
    "openai": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "license": "BUSL-1.1",
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.7"
    }
  }
}
